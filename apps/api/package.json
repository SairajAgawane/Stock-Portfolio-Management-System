{
  "name": "stock-portfolio-api",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "cd ../.. && prisma generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "test:unit": "tsx --test tests/**/*.test.ts",
    "test": "pnpm test:unit"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
