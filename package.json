{
  "name": "stock-portfolio-management",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "api:dev": "npm --prefix apps/api run dev",
    "api:build": "npm --prefix apps/api run build",
    "api:start": "npm --prefix apps/api start",
    "build": "npm --prefix apps/api run build",
    "prestart": "prisma migrate deploy && prisma db seed",
    "start": "npm --prefix apps/api start",
    "test": "npm --prefix apps/api test"
  },
  "devDependencies": {
    "@prisma/client": "^6.16.0",
    "prisma": "^6.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ]
}
